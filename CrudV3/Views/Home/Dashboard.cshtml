<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <!-- Hace que la página se vea bien en celulares y tablets -->
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Dashboard - CrudV3</title>
    <!-- Incluye Bootstrap para hacer la página bonita -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
    <!-- Barra de navegación azul en la parte superior -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
        <div class="container">
            <!-- Nombre de la aplicación que aparece en la esquina izquierda -->
            <a class="navbar-brand" href="#">CrudV3</a>

            <!-- Elementos del menú que van a la derecha -->
            <div class="navbar-nav ms-auto">
                <!-- Saludo personalizado con el nombre del usuario -->
                <span class="navbar-text me-3">Bienvenido, @ViewBag.Username</span>
                <!-- Botón para cerrar sesión -->
                <a class="nav-link" href="@Url.Action("Logout", "Home")">Cerrar Sesión</a>
            </div>
        </div>
    </nav>

    <!-- Contenido principal de la página -->
    <div class="container mt-4">
        <div class="row">
            <div class="col-12">
                <!-- Título principal del panel -->
                <h2>Panel de Administración</h2>

                <!-- Tarjeta que contiene información sobre gestión de usuarios -->
                <div class="card">
                    <div class="card-body">
                        <!-- Título de la tarjeta -->
                        <h5 class="card-title">Gestión de Usuarios</h5>
                        <!-- Descripción de lo que se puede hacer -->
                        <p class="card-text">Administra los usuarios del sistema.</p>
                        <!-- Botón que lleva a la página de usuarios -->
                        <a href="@Url.Action("Index", "Users")" class="btn btn-primary">Ir a Usuarios</a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- JavaScript de Bootstrap para que funcionen las animaciones -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>