@model CrudV3.Models.LoginViewModel

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login - CrudV3</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-6 col-lg-4">
                <div class="card shadow-sm mt-5">
                    <div class="card-body">
                        <h3 class="text-center mb-4">Iniciar Sesión</h3>

                        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                        {
                            <div class="alert alert-danger" role="alert">
                                @Model.ErrorMessage
                            </div>
                        }

                        <form asp-action="Login" method="post">
                            @Html.AntiForgeryToken()

                            <div class="mb-3">
                                <label asp-for="Username" class="form-label">Usuario</label>
                                <input asp-for="Username" class="form-control" placeholder="Ingresa tu usuario" />
                                <span asp-validation-for="Username" class="text-danger"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Password" class="form-label">Contraseña</label>
                                <input asp-for="Password" type="password" class="form-control" placeholder="Ingresa tu contraseña" />
                                <span asp-validation-for="Password" class="text-danger"></span>
                            </div>

                            <div class="d-grid">
                                <button type="submit" class="btn btn-primary">Iniciar Sesión</button>
                            </div>
                        </form>


                    </div>
                </div>
            </div@* 
   DIRECTIVA DEL MODELO
   - Define que esta vista está fuertemente tipada al modelo LoginViewModel
   - Permite acceder a las propiedades del modelo usando Model.PropertyName
   - Proporciona IntelliSense y validación en tiempo de compilación
*@
@model CrudV3.Models.LoginViewModel

@* ESTRUCTURA HTML BASE *@
<!DOCTYPE html>
<html lang="es">
 @* Documento HTML5 en español *@
<head>
    <meta charset="utf-8" /> @* Codificación de caracteres UTF-8 *@
    <meta name="viewport" content="width=device-width, initial-scale=1.0" /> @* Viewport para responsive design *@
    <title>Login - CrudV3</title> @* Título de la página que aparece en la pestaña del navegador *@
    @* 
       BOOTSTRAP CSS
       - Se incluye Bootstrap 5.3.0 desde CDN
       - Proporciona estilos CSS predefinidos para componentes y layout
    *@
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

@* 
   BODY CON CLASE BOOTSTRAP
   - bg-light: Aplica un fondo claro (gris muy suave)
*@
<body class="bg-light">
    @* 
       CONTENEDOR PRINCIPAL
       - container: Contenedor responsive de Bootstrap que se adapta al tamaño de pantalla
       - Aplica márgenes automáticos y padding lateral
    *@
    <div class="container">
        @* 
           SISTEMA DE GRID DE BOOTSTRAP
           - row: Crea una fila en el sistema de grid
           - justify-content-center: Centra horizontalmente el contenido
        *@
        <div class="row justify-content-center">
            @* 
               COLUMNAS RESPONSIVE
               - col-md-6: En pantallas medianas (≥768px) ocupa 6/12 columnas (50% del ancho)
               - col-lg-4: En pantallas grandes (≥992px) ocupa 4/12 columnas (33% del ancho)
               - En pantallas pequeñas ocupa todo el ancho disponible
            *@
            <div class="col-md-6 col-lg-4">
                @* 
                   TARJETA DE LOGIN
                   - card: Componente de Bootstrap que crea una tarjeta con borde y padding
                   - shadow-sm: Aplica una sombra ligera para dar profundidad
                   - mt-5: Margen superior grande (5 unidades en escala de Bootstrap)
                *@
                <div class="card shadow-sm mt-5">
                    @* 
                       CUERPO DE LA TARJETA
                       - card-body: Aplica padding interno estándar de Bootstrap
                    *@
                    <div class="card-body">
                        @* 
                           TÍTULO PRINCIPAL
                           - h3: Encabezado de nivel 3
                           - text-center: Centra el texto horizontalmente
                           - mb-4: Margen inferior grande para separación
                        *@
                        <h3 class="text-center mb-4">Iniciar Sesión</h3>

                        @* 
                           MANEJO DE ERRORES CON RAZOR
                           - Código C# que evalúa si existe un mensaje de error
                           - Solo se renderiza si Model.ErrorMessage no está vacío o nulo
                        *@
                        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                        {
                            @* 
                               ALERTA DE ERROR
                               - alert alert-danger: Componente de Bootstrap para mostrar mensajes de error (rojo)
                               - role="alert": Atributo de accesibilidad para lectores de pantalla
                            *@
                            <div class="alert alert-danger" role="alert">
                                @Model.ErrorMessage @* Renderiza el mensaje de error desde el modelo *@
                            </div>
                        }

                        @* 
                           FORMULARIO PRINCIPAL
                           - asp-action="Login": Tag helper que genera la URL para la acción Login del controlador actual
                           - method="post": Especifica que se usará HTTP POST (más seguro para credenciales)
                        *@
                        <form asp-action="Login" method="post">
                            @* 
                               TOKEN ANTI-FALSIFICACIÓN (CSRF)
                               - Genera un token oculto para prevenir ataques Cross-Site Request Forgery
                               - ASP.NET Core verificará este token al procesar el formulario
                            *@
                            @Html.AntiForgeryToken()

                            @* 
                               CAMPO DE USUARIO
                               - mb-3: Margen inferior mediano para separación entre campos
                            *@
                            <div class="mb-3">
                                @* 
                                   ETIQUETA DEL CAMPO
                                   - asp-for="Username": Tag helper que enlaza la etiqueta con la propiedad Username del modelo
                                   - Genera automáticamente el atributo 'for' con el ID correcto
                                   - form-label: Clase de Bootstrap para estilo de etiquetas
                                *@
                                <label asp-for="Username" class="form-label">Usuario</label>
                                @* 
                                   CAMPO DE ENTRADA
                                   - asp-for="Username": Enlaza el input con la propiedad Username del modelo
                                   - Genera automáticamente name, id, y value del campo
                                   - form-control: Clase de Bootstrap para estilo de campos de entrada
                                   - placeholder: Texto de ayuda que aparece cuando el campo está vacío
                                *@
                                <input asp-for="Username" class="form-control" placeholder="Ingresa tu usuario" />
                                @* 
                                   SPAN DE VALIDACIÓN
                                   - asp-validation-for="Username": Muestra mensajes de validación para el campo Username
                                   - text-danger: Clase de Bootstrap para texto rojo (errores)
                                   - Se llena automáticamente si hay errores de validación
                                *@
                                <span asp-validation-for="Username" class="text-danger"></span>
                            </div>

                            @* 
                               CAMPO DE CONTRASEÑA
                               - Estructura similar al campo de usuario
                            *@
                            <div class="mb-3">
                                @* Etiqueta para el campo de contraseña *@
                                <label asp-for="Password" class="form-label">Contraseña</label>
                                @* 
                                   INPUT DE CONTRASEÑA
                                   - type="password": Oculta el texto ingresado (muestra asteriscos o puntos)
                                   - Mismos tag helpers que el campo de usuario
                                *@
                                <input asp-for="Password" type="password" class="form-control" placeholder="Ingresa tu contraseña" />
                                @* Span para mostrar errores de validación de contraseña *@
                                <span asp-validation-for="Password" class="text-danger"></span>
                            </div>

                            @* 
                               CONTENEDOR DEL BOTÓN
                               - d-grid: Clase de Bootstrap que hace que el botón ocupe todo el ancho disponible
                            *@
                            <div class="d-grid">
                                @* 
                                   BOTÓN DE ENVÍO
                                   - type="submit": Especifica que es un botón de envío del formulario
                                   - btn btn-primary: Clases de Bootstrap para botón azul estilizado
                                   - Al hacer clic, enviará el formulario al servidor
                                *@
                                <button type="submit" class="btn btn-primary">Iniciar Sesión</button>
                            </div>
                        </form>

                        @* 
                           INFORMACIÓN DE CREDENCIALES (SOLO PARA DESARROLLO)
                           - mt-3: Margen superior mediano
                           - text-center: Centra el texto
                        *@
                        <div class="mt-3 text-center">
                            @* 
                               CREDENCIALES VISIBLES
                               - small: Elemento HTML para texto pequeño
                               - text-muted: Clase de Bootstrap para texto gris claro
                               - ¡IMPORTANTE! Esto solo debe usarse en desarrollo, nunca en producción
                            *@
                            <small class="text-muted">Usuario: admin | Contraseña: 123456</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @* 
       BOOTSTRAP JAVASCRIPT
       - Incluye el JavaScript de Bootstrap desde CDN
       - bundle.min.js incluye Bootstrap JS + Popper.js (para tooltips, dropdowns, etc.)
       - Necesario para funcionalidades interactivas de Bootstrap
    *@
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>

@* 
   RESUMEN DE CARACTERÍSTICAS TÉCNICAS:
   
   1. FUERTEMENTE TIPADO: Usa LoginViewModel para type safety y IntelliSense
   2. SEGURIDAD: Incluye token anti-falsificación para prevenir ataques CSRF
   3. VALIDACIÓN: Preparado para mostrar errores de validación del lado del servidor
   4. RESPONSIVE: Diseño que se adapta a diferentes tamaños de pantalla
   5. ACCESIBILIDAD: Incluye atributos ARIA y estructura semántica
   6. UX: Placeholders informativos y diseño centrado en el usuario
   7. MANTENIMIENTO: Código limpio y bien estructurado usando las mejores prácticas de ASP.NET Core MVC
   
   FLUJO DE FUNCIONAMIENTO:
   1. El usuario accede a la página de login
   2. Si hay errores previos, se muestran en la alerta roja
   3. El usuario llena los campos de usuario y contraseña
   4. Al enviar el formulario, se ejecuta la acción Login del controlador
   5. El token CSRF se valida automáticamente
   6. Si hay errores de validación, se muestran bajo cada campo
   7. Si el login es exitoso, se redirige a la página principal
*@
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>