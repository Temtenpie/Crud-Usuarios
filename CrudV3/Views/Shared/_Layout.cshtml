<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CrudV3</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="~/css/site.css" rel="stylesheet" />
</head>
<body>
    <!-- Navegación -->
    <nav class="navbar navbar-expand-lg">
        <div class="container">
            <a class="navbar-brand" href="#">CrudV3</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("Index", "Home")">Inicio</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("Index", "Employees")">Empleados</a>
                    </li>
                </ul>
                <span class="navbar-text">
                    Bienvenido, @User.Identity.Name
                </span>
                <ul class="navbar-nav">
                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("Logout", "Account")">Cerrar Sesión</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <!-- Contenido principal -->
    <div class="main-content">
        <div class="container mt-4">
            @RenderBody()
        </div>
    </div>

    <!-- Footer -->
    <footer class="footer">
        <div class="container">
            <div class="footer-content">
                <div class="footer-logo">
                    CrudV3
                </div>
                <div class="footer-links">
                    <a href="@Url.Action("Index", "Home")" class="footer-link">Inicio</a>
                    <a href="@Url.Action("Index", "Employees")" class="footer-link">Empleados</a>
                    <a href="#" class="footer-link">Acerca de</a>
                    <a href="#" class="footer-link">Contacto</a>
                    <a href="#" class="footer-link">Ayuda</a>
                </div>
            </div>
            <div class="footer-info">
                <p>&copy; 2024 CrudV3. Todos los derechos reservados. | Desarrollado con 💚 y ASP.NET Core</p>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>